  "rules": [
    {
      "id": "a1455ebb",
      "name": "person_with_titles",
      "description": "Captures person names preceded by German academic/professional titles (Dr., Mag., Univ.-Prof., Hon.-Prof., etc.) including the title in the match.",
      "format": "regex",
      "content": "(?:Univ\\.-?Prof\\.\\s+)?(?:Hon\\.-?Prof\\.\\s+)?(?:Vize)?(?:Senats)?(?:Hof)?(?:Rat|R\u00e4|R\u00e4tin|R\u00e4tinnen|Pr\u00e4sident|Pr\u00e4sidentin|Vizepr\u00e4sident|Vizepr\u00e4sidentin)\\s+(?:Dr\\.\\s+)?(?:Mag\\.\\s+)?(?:MMag\\.\\s+)?(?:PD\\.\\s+)?(?:PhD\\s+)?([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)",
      "priority": 10,
      "output_template": {
        "text": "$0",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-07-27T15:31:23.372271"
    },
    {
      "id": "e4cfc784",
      "name": "person_standalone",
      "description": "Captures standalone person names in legal party contexts (e.g., 'gegen die beklagte Partei [Name]') or simple lists.",
      "format": "regex",
      "content": "(?:gegen die beklagte Partei|der klagenden Partei|der Antragsteller|des Antragsgegners|des Vaters|der Mutter|des minderj\\u00e4hrigen|minderj\\u00e4hrigen|als weitere|vertreten durch|durch den|durch die|und|,\\s+)([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)",
      "priority": 8,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-07-27T15:31:23.372274"
    },
    {
      "id": "9ea46d25",
      "name": "person_with_dr_prefix",
