              "description": "Matches person names with academic suffixes like MA, MSc, LL.M., BEd that are not part of a title.",
              "format": "regex",
              "content": "(?:^|\\.|\\n|\\s)(?<!\\w)([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)(?:\\s+(?:MA|MSc|LL\\.M\\.|BEd))?(?=[,\\s]|\\s+und\\s|[\\s.])",
