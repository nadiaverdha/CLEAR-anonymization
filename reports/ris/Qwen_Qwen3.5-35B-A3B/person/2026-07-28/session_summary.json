            {
              "id": "fa0ee5bf",
              "name": "title_person_honorific",
              "description": "Specifically handles 'Hofrat' and 'Hofr\u00e4tin' titles which were failing in the original rule.",
              "format": "regex",
              "content": "(?:Hofrat|Hofr\u00e4tin|Hofr\u00e4t)\\s+([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*)",
              "priority": 4,
              "output_template": {
                "text": "$0",
                "start": "$start",
                "end": "$end",
                "type": "person"
              },
              "output_key": "entities"
            },
            {
              "id": "bde1dafd",
              "name": "title_person",
              "description": "Matches person names preceded by standard academic or professional titles, including complex hyphenated titles like 'Dipl.-Ing.', 'Univ.-Prof.', and the specific 'Prof.in Univ.-Prof.in' pattern.",
              "format": "regex",
              "content": "(?:Dipl\\.-Ing\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|PhD|Vizepr\\.|Senatspr\\.|Hofrat|Hofr\\u00e4t|Hofr\\u00e4tin|Prof\\.in Univ\\.-Prof\\.in|Prof\\.in|Prof\\.|Dr\\.|Mag\\.|Vizepr\\.|Senatspr\\.|Hofrat|Hofr\\u00e4t|Hofr\\u00e4tin)\\s+([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df\\-]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df\\-]+)*(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df\\-]+)?)\\s*(?:,\\s+(?:MA|MSc|LL\\.M\\.|BEd|Ing\\.|DI|MMag\\.|Priv\\.-Doz\\.)?)?",
              "priority": 9,
              "output_template": {
                "text": "$0",
                "start": "$start",
                "end": "$end",
                "type": "person"
              },
              "output_key": "entities"
            },
            {
              "id": "40caa15a",
              "name": "complex_title_person",
              "description": "Matches person names with complex multi-part titles like 'Univ.-Prof. Dr.', 'Hon.-Prof. PD Dr.', 'MMag.', 'Mag. Dr.', 'DI', 'Ing.', 'Bakk. iur.'.",
              "format": "regex",
              "content": "(?:Univ\\.-Prof\\.\\s+Dr\\.|Hon\\.-Prof\\.\\s+PD\\s+Dr\\.|MMag\\.|Mag\\.\\s+Dr\\.|DI\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+|Ing\\.|Bakk\\.\\s+iur\\.\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*(?:\\s+(?:MA|MSc|LL\\.M\\.|BEd))?",
              "priority": 8,
              "output_template": {
                "text": "$0",
                "start": "$start",
                "end": "$end",
                "type": "person"
              },
              "output_key": "entities"
            },
            {
