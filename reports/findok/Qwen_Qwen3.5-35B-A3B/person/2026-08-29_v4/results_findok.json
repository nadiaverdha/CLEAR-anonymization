  "rules": [
    {
      "id": "38a71026",
      "name": "names_after_fa_context",
      "description": "Captures person names appearing after 'Fa.' (Firma) or 'Fa' (Company) abbreviation, which often precedes a person's name in legal texts referring to a sole proprietorship or similar.",
      "format": "regex",
      "content": "(?:Fa\\.|Fa)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df]+)+)",
      "priority": 7,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-08-29T09:38:57.563608"
    },
    {
      "id": "05826052",
      "name": "names_after_sachbearbeiter",
      "description": "Captures names following 'Sachbearbeiter' or 'Sachbearbeiterin' which often precede a person's name in administrative contexts.",
      "format": "regex",
      "content": "(?:Sachbearbeiter|Sachbearbeiterin)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df]+)+)",
      "priority": 7,
      "output_template": {
        "text": "$1",
