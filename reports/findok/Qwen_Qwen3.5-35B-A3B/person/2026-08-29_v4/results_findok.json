        "format": "regex",
        "content": "(?:Fa\\.|Fa)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df]+)+)",
        "priority": 7,
        "output_template": {
          "text": "$1",
          "start": "$start",
          "end": "$end",
          "type": "person"
        },
        "output_key": "entities"
      },
