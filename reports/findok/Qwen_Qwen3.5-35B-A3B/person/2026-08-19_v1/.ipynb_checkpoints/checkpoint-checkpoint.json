{
  "phase": "phase1",
  "completed_batches": 3,
  "rules": [
    {
      "id": "49291430",
      "name": "Complaint Case Context",
      "description": "Matches persons mentioned immediately after 'in der Beschwerdesache' (in the complaint case), including titles and suffixes. This rule is kept but its pattern is implicitly handled by the stricter title/name matching in the other rules, or acts as a fallback for names without titles in this specific context.",
      "format": "regex",
      "content": "in\\s+der\\s+Beschwerdesache\\s+(?:des\\s+|der\\s+)?([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*(?:\\s*,\\s*[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)*)",
      "priority": 9,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities"
    },
    {
      "id": "ce712b26",
      "name": "Herr/Frau Address",
      "description": "Matches persons addressed as Herr or Frau in the text.",
      "format": "regex",
      "content": "(?:Herr|Frau)\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)",
      "priority": 6,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities"
    },
    {
      "id": "9b46a3d5",
      "name": "Deceased Person Context",
      "description": "Matches persons identified as deceased (verstorbenen) in inheritance contexts.",
      "format": "regex",
      "content": "verstorbenen\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)",
      "priority": 5,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities"
    },
    {
      "id": "9ba5a309",
      "name": "Genitive Case Person",
      "description": "Matches persons mentioned in genitive case after 'des' (masculine/neuter) or 'der' (feminine) in legal contexts like 'Beschwerdesache des/der'. Captures name and suffixes but stops before addresses.",
      "format": "regex",
      "content": "(?:des\\s+|der\\s+)(?:(?:Mag\\.|Mag\\.a|Mag\\.Dr|Dr\\.in|Dr\\.|Univ\\.-Prof\\.|Univ\\.-Prof\\.in|Hon\\.-Prof\\.|Hon\\.-Prof\\.in|Priv\\.-Doz\\.|Priv\\.-Doz\\.in|LL\\.M\\.?|B\\.A\\.?|B\\.A\\.\\.?|B\\.A\\.\\.\\.?|B\\.A\\.\\.\\.\\.?|RgR|KommR|OSR|OMedR|MedR|PhD|Ing\\.\\s+|DI\\.\\s+|Dipl\\.-Ing\\.\\s+|Dipl\\.\\s+)?)([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*(?:\\s*,\\s*[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)*)",
      "priority": 8,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities"
    }
  ],
