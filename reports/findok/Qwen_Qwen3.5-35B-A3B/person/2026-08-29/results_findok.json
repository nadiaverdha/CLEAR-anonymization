  "rules": [
    {
      "id": "a7b4c2e1",
      "name": "Deceased Person Reference",
      "description": "Captures the name of a deceased person referenced in the text (e.g., 'verstorbenen').",
      "format": "regex",
      "content": "(?:verstorbenen|Verstorbenen)(?:\\s+|\\n)*(?:[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*)",
      "priority": 6,
      "output_template": {
        "text": "$0",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-08-29T03:42:21.282919"
    },
    {
      "id": "583afeab",
      "name": "Judge Name Extraction",
      "description": "Captures the judge's full name including title following 'durch den/die' + role, ensuring the title is part of the match and the name follows immediately.",
      "format": "regex",
      "content": "(?:durch\\s+(?:den\\s+)?(?:Richter|Richterin|Senatsvorsitzenden|Priv\\.-Doz\\.|Priv\\.-Doz\\.in|Hon\\.-Prof\\.|Hon\\.-Prof\\.in|Univ\\.-Prof\\.|Univ\\.-Prof\\.in|Mag\\.|Mag\\.a|Mag\\.in|Mag\\.Dr\\.|Mag\\.Dr\\.in|OSR|StR|KommR|OMedR|MedR|VetR|\\u00d6kR|RgR|HR|MMag\\.|R\\.|Bakk\\.|LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Ing\\.|Dipl\\.-Ing\\.|PhD|Techn\\s+R|Techn\\s+R\\.\\s+))([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*(?:\\s+(?:LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|PhD|\\u00d6kR|OMedR|MedR|VetR|OSR|StR|KommR|HR|RgR|Dr\\.|Mag\\.|Mag\\.a|Mag\\.in|Ing\\.|Dipl\\.-Ing\\.|Priv\\.-Doz\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|MMag\\.|R\\.)?)?)",
      "priority": 10,
      "output_template": {
        "text": "$0",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-08-29T03:46:21.351377"
    },
    {
      "id": "1f050eb9",
      "name": "General Name with Title",
      "description": "Captures names with titles in other contexts, ensuring the title is part of the match and the name follows immediately, extracting the full title+name. Requires a preceding context anchor to avoid false positives.",
      "format": "regex",
      "content": "(?:Herrn?\\s+|Frau\\s+|in\\s+der\\s+Beschwerdesache\\s+(?:des\\s+|der\\s+)?|in\\s+der\\s+Rechtssache\\s+gegen\\s+|des\\s+|der\\s+|als\\s+|von\\s+|gegen\\s+|mit\\s+|bei\\s+|zu\\s+|durch\\s+|der\\s+|die\\s+|das\\s+)(?:Dr\\.|Dr\\.in\\s+|Mag\\.|Mag\\.a\\s+|Mag\\.in\\s+|Mag\\.Dr\\.|Mag\\.Dr\\.in\\s+|Univ\\.-Prof\\.|Univ\\.-Prof\\.in\\s+|Priv\\.-Doz\\.|Priv\\.-Doz\\.in\\s+|Hon\\.-Prof\\.|Hon\\.-Prof\\.in\\s+|KommR\\s+|OSR\\s+|StR\\s+|OMedR\\s+|MedR\\s+|PhD\\s+|\\u00d6kR\\s+|VetR\\s+|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|LL\\.M\\.|M\\.B\\.L\\.|MSc\\s+|MA\\s+|BA\\s+|BSc\\s+|Ing\\.|Dipl\\.-Ing\\.|RgR\\s+|HR\\s+|MMag\\.|R\\.\\s+|Techn\\s+R\\s+)([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*(?:\\s+(?:LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|PhD|\\u00d6kR|OMedR|MedR|VetR|OSR|StR|KommR|HR|RgR|Dr\\.|Mag\\.|Mag\\.a|Mag\\.in|Ing\\.|Dipl\\.-Ing\\.|Priv\\.-Doz\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|MMag\\.|R\\.)?)?)",
      "priority": 8,
      "output_template": {
        "text": "$0",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-08-29T03:46:21.351399"
    },
    {
      "id": "8c92f06c",
      "name": "Name with Suffix Extraction",
      "description": "Captures names followed by a comma and a degree/suffix (e.g., 'Name, Bakk. techn.') which are common in legal texts, extracting the full name and suffix.",
      "format": "regex",
      "content": "(?:[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*(?:\\s+(?:LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|PhD|\\u00d6kR|OMedR|MedR|VetR|OSR|StR|KommR|HR|RgR|Dr\\.|Mag\\.|Mag\\.a|Mag\\.in|Ing\\.|Dipl\\.-Ing\\.|Priv\\.-Doz\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|MMag\\.|R\\.)?)?)\\s*,\\s*(?:LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|PhD|\\u00d6kR|OMedR|MedR|VetR|OSR|StR|KommR|HR|RgR|Dr\\.|Mag\\.|Mag\\.a|Mag\\.in|Ing\\.|Dipl\\.-Ing\\.|Priv\\.-Doz\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|MMag\\.|R\\.)",
      "priority": 7,
      "output_template": {
        "text": "$0",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "created_at": "2026-08-29T03:46:21.351418"
    },
    {
      "id": "039b37eb",
      "name": "Party Name Extraction",
      "description": "Captures the name of the party (appellant/respondent) following 'Beschwerdesache' or 'Verwaltungsstrafsache', ensuring the match is a capitalized name and not a common noun, excluding trailing punctuation.",
      "format": "regex",
      "content": "(?:Beschwerdesache|Verwaltungsstrafsache|Revisionssache|Rechtsstreit)\\s+(?:des\\s+|der\\s+)?([A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+(?:\\s+[A-Z][a-z\\u00e4\\u00f6\\u00fc\\u00df]+)*(?:\\s+(?:LL\\.M\\.|M\\.B\\.L\\.|MSc|MA|BA|BSc|Bakk\\.\\s*techn\\.|Bakk\\.\\s*art\\.|Bakk\\.\\s*phil\\.|Bakk\\.\\s*jur\\.|PhD|\\u00d6kR|OMedR|MedR|VetR|OSR|StR|KommR|HR|RgR|Dr\\.|Mag\\.|Mag\\.a|Mag\\.in|Ing\\.|Dipl\\.-Ing\\.|Priv\\.-Doz\\.|Univ\\.-Prof\\.|Hon\\.-Prof\\.|MMag\\.|R\\.)?)?)",
      "priority": 9,
