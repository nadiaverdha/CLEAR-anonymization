      "format": "regex",
      "content": "(?:vertreten\\s+durch(?:\\s+(?:den|der))?)([A-Z][a-z\u00e4\u00f6\u00fc\u00df]+(?:\\s+(?:Mag\\.a?|Dr\\.in?|RA|MMag\\.))?)(?:[A-Z][a-z]+(?:[A-Z][a-z]+)*)",
      "priority": 8,
      "output_template": {
