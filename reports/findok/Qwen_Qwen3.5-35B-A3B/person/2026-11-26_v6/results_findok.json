  "rules": [
    {
      "id": "edefcae4",
      "name": "abbreviated_person_herr_frau",
      "description": "Captures abbreviated person references like 'Herr M.' or 'Frau M.' found in later text sections.",
      "format": "regex",
      "content": "(?:Herr|Frau)\\s+([A-Z])\\.",
      "priority": 8,
      "output_template": {
        "text": "$1 $2.",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "validated_precision": 0.0,
      "validated_support": 27,
      "created_at": "2026-11-26T12:42:41.136135"
    },
    {
      "id": "f3883c29",
      "name": "party_person_defendant",
      "description": "Captures parties identified after 'in der Beschwerdesache' or 'in der Verwaltungsstrafsache', handling hyphenated names, titles like Dr.in, and suffixes like BSc, MSc.",
      "format": "regex",
      "content": "(?:in\\s+(?:der\\s+)?Beschwerdesache(?:\\s+des)?|in\\s+der\\s+Verwaltungsstrafsache)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+)+)",
      "priority": 9,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "validated_precision": 0.8879668049792531,
      "validated_support": 482,
      "created_at": "2026-11-26T12:42:41.136172"
    },
    {
      "id": "d3dfb3b6",
      "name": "judge_person",
      "description": "Captures judges with complex titles (Dr., Mag., Priv.-Doz.in, etc.) and hyphenated names after 'durch den Richter' or 'durch die Richterin'. Handles suffixes like LL.M., BSc, MSc and German characters.",
      "format": "regex",
      "content": "(?:durch\\s+(?:den\\s+)?Richter|durch\\s+(?:die\\s+)?Richterin)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+)+)",
      "priority": 10,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "validated_precision": 0.8243243243243243,
      "validated_support": 444,
      "created_at": "2026-11-26T12:42:41.136201"
    },
    {
      "id": "ff8c213a",
      "name": "representative_person",
      "description": "Captures legal representatives after 'vertreten durch', explicitly excluding corporate entities ending in GmbH, AG, KG, etc. Handles multiple names separated by '&'.",
      "format": "regex",
      "content": "(?:vertreten\\s+durch)\\s+([A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+(?:\\s+[A-Z][a-z\u00e4\u00f6\u00fc\u00df\u00c4\u00d6\u00dc\u00df\\.\\-]+)+)(?!\\s+(?:GmbH|AG|KG|PartG|UG|OHG|SE))",
      "priority": 8,
      "output_template": {
        "text": "$1",
        "start": "$start",
        "end": "$end",
        "type": "person"
      },
      "output_key": "entities",
      "validated_precision": 0.4161490683229814,
      "validated_support": 161,
      "created_at": "2026-11-26T12:42:41.136228"
    },
    {
      "id": "94ae579e",
      "name": "generic_title_initial_person",
